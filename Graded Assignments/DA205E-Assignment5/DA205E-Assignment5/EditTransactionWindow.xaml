<Window x:Class="DA205E_Assignment5.EditTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DA205E_Assignment5"
        xmlns:converters="clr-namespace:DA205E_Assignment5.Converters"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Edit transaction" Height="300" Width="400">
    <Window.Resources>
        <converters:DecimalToStringConverter x:Key="DecimalToStringConverter" /> <!-- Converter for the amount -->
    </Window.Resources>
    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Row 0 -->
        <Label Grid.Row="0" Grid.Column="0" x:Name="lblDescription" Target="{Binding ElementName=txtDescription}" Content="Description" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtDescription" Text="{Binding Description}" Margin="40,0,0,0"/>

        <!-- Row 1 -->
        <Label Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" x:Name="lblDate" Target="{Binding ElementName=dpDate}" Content="Date" />
        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpDate" SelectedDate="{Binding Date}" Margin="40,10,0,0"/>

        <!-- Row 2 -->
        <Label Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" x:Name="lblAmount" Target="{Binding ElementName=txtAmount}" Content="Amount" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAmount" Text="{Binding Amount, Converter={StaticResource DecimalToStringConverter}}" Margin="40,10,0,0"/>

        <!-- Row 3 -->
        <Label Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" x:Name="lblType" Target="{Binding ElementName=cmbCategory}" Content="Category" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategorySelection}" Grid.Row="3" Grid.Column="1" x:Name="cmbCategory" Margin="40,10,0,0">
            <ComboBox.ItemTemplate> <!-- ItemTemplate to specify the format of how the categories are displayed-->
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Margin="0,0,5,0"/>
                        <!-- The name of the category -->

                        <TextBlock Text="(" />
                        <TextBlock Text="{Binding Type}"/>
                        <!-- The type of the category (expense/revenue) -->
                        <TextBlock Text=")" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Row 4, Could be layouted better but I don't have time for that right now -->
        <Button Grid.Row="4" IsDefault="True" Grid.Column="1" Margin="0,25,0,0" Padding="25,5" Content="Save changes" x:Name="btnSave" HorizontalAlignment="Center" Click="btnSave_Click" Height="28" VerticalAlignment="Top" />
        <Button Grid.Row="4" Grid.ColumnSpan="1" Margin="40,25,0,0" Padding="25,5" Content="Cancel" x:Name="btnCancel" HorizontalAlignment="Center" Click="btnCancel_Click" />
    </Grid>
</Window>
