<Window x:Class="DA205E_Assignment5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DA205E_Assignment5"
        xmlns:converters="clr-namespace:DA205E_Assignment5.Converters"
        xmlns:categories="clr-namespace:DA205E_Assignment5.Model.Category"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Cash-Flow Management"
        Height="741" 
        Width="800">
    <Window.Resources>
        <!-- Converters -->
        <converters:DecimalToStringConverter x:Key="DecimalToStringConverter" />
        <converters:CategoryFormatConverter x:Key="CategoryFormatConverter" />
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Window.Resources>
    <!-- Menu -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click"/>
                <MenuItem Header="_Open..." Click="Open_Click"/>
                <MenuItem Header="_Save" Click="Save_Click"/>
                <MenuItem Header="_Save as" Click="SaveAs_Click"/>
                <MenuItem Header="Generate monthly report" Click="btnGenerateReport_Click"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Row 0, Col 0: Add category -->
            <GroupBox Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" Header="Add category">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                       
                    <!-- Category name -->
                    <Label Grid.Row="0" Grid.Column="0" x:Name="lblCategoryName" Target="{Binding ElementName=txtCategoryName}" Content="Name" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCategoryName" Text="{Binding CategoryName}" Margin="40,0,0,0"/>

                    <!-- Category type -->
                    <Label Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" x:Name="lblCategoryType" Target="{Binding ElementName=cmbCategoryType}" Content="Type" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbCategoryType" Margin="40,10,0,0" />

                    <!-- Add button -->
                    <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,15,0,0" Padding="25,5" Content="Add category" x:Name="btnAddCategory" HorizontalAlignment="Center" Click="btnAddCategory_Click" />
                </Grid>
            </GroupBox>

            <!-- Row 0, Col 1: Manage categories-->
            <GroupBox Grid.Row="0" Grid.Column="1" Margin="5,0,0,5" Header="Manage categories">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Listbox of categories -->
                    <ListBox x:Name="lstCategories" ItemsSource="{Binding Categories}" Grid.Row="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="0,0,5,0"/>
                                    <!-- The name of the category -->
                                    <TextBlock Text="(" />
                                    <TextBlock Text="{Binding Type}"/>
                                    <!-- The type of the category (expense/revenue) -->
                                    <TextBlock Text=")" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Button stack panel -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <Button x:Name="btnDeleteCategory" Content="Delete" Padding="25, 0" Margin="0,0,10,0" Click="btnDeleteCategory_Click" />
                        <Button x:Name="btnClearCategorySelection" Content="Clear" Padding="25, 0" Click="btnClearCategorySelection_Click" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Row 1, Col 0: Add transaction -->
            <GroupBox Grid.Row="1" Grid.Column="0" Margin="0,5,5,0" Header="Add transaction">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Description -->
                    <Label Grid.Row="0" Grid.Column="0" x:Name="lblDescription" Target="{Binding ElementName=txtDescription}" Content="Description" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtDescription" Text="{Binding TransactionDescription}" Margin="40,0,0,0"/>

                    <!-- Date -->
                    <Label Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" x:Name="lblDate" Target="{Binding ElementName=dpDate}" Content="Date" />
                    <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpDate" SelectedDate="{Binding TransactionDate}" Margin="40,10,0,0"/>

                    <!-- Amount -->
                    <Label Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" x:Name="lblAmount" Target="{Binding ElementName=txtAmount}" Content="Amount" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAmount" Text="{Binding TransactionAmount, Converter={StaticResource DecimalToStringConverter}}" Margin="40,10,0,0"/>

                    <!-- Category -->
                    <Label Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" x:Name="lblType" Target="{Binding ElementName=cmbCategory}" Content="Category" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding TransactionCategory}" Grid.Row="3" Grid.Column="1" x:Name="cmbCategory" Margin="40,10,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="0,0,5,0"/>
                                    <!-- The name of the category -->

                                    <TextBlock Text="(" />
                                    <TextBlock Text="{Binding Type}"/>
                                    <!-- The type of the category (expense/revenue) -->
                                    <TextBlock Text=")" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Add button -->
                    <Button Grid.Row="4" Grid.ColumnSpan="2" Margin="0,15,0,0" Padding="25,5" Content="Add transaction" x:Name="btnAddTransaction" HorizontalAlignment="Center" Click="btnAddTransaction_Click" />
                </Grid>
            </GroupBox>

            <!-- Row 1, Col 1: Manage transactions -->
            <GroupBox Grid.Row="1" Grid.RowSpan="2" Margin="5,5,0,0" Grid.Column="1" Header="Manage transactions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter and search -->
                    <GroupBox Grid.Row="0" Header="Filter and Search">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Search -->
                            <Label Margin="0,10,0,0" Content="Search (description)" Target="{Binding ElementName=txtSearch}"/>
                            <TextBox Margin="40,10,0,0" x:Name="txtSearch" Grid.Column="1" Text="{Binding SearchDescription, UpdateSourceTrigger=PropertyChanged}"/> <!-- The UpdateSourceTrigger assures that the set is called as soon as something is being inputted rather than after leaving the textbox TODO: Make sure my understanding is correct-->
                            <Button Grid.Column="2" Margin="10,10,0,0" x:Name="btnClearSearch" Content="X" Click="ClearThisFilter_Click"  Padding="10,0"/>

                            <!-- Category -->
                            <Label Margin="0,10,0,0" Grid.Row="1" Grid.Column="0"  Content="Filter by category"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterSelectedCategory}" Margin="40,10,0,0" Grid.Row="1" Grid.Column="1">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Margin="0,0,5,0"/>
                                            <!-- The name of the category -->

                                            <TextBlock Text="(" />
                                            <TextBlock Text="{Binding Type}"/>
                                            <!-- The type of the category (expense/revenue) -->
                                            <TextBlock Text=")" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Row="1" Grid.Column="2" Margin="10,10,0,0" x:Name="btnClearCategory" Content="X" Click="ClearThisFilter_Click"  Padding="10,0"/>

                            <!-- Category type-->
                            <Label Margin="0,10,0,0" Grid.Row="2" Grid.Column="0" Content="Filter by category type"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,10,0,0" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <RadioButton Content="Expense" IsChecked="{Binding FilterCategoryType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static categories:CategoryType.Expense}}"/>
                                <RadioButton Margin="10,0,0,0" Content="Revenue" IsChecked="{Binding FilterCategoryType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static categories:CategoryType.Revenue}}"/>
                                <RadioButton Margin="10,0,0,0" Content="All" IsChecked="{Binding FilterCategoryType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Null}}"/><!-- pre-checking as all is a resonable default choice -->
                            </StackPanel>

                            <!-- Month -->
                            <Label Margin="0,10,0,0" Grid.Row="3" Grid.Column="0" Content="Filter by month"/>
                            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding FilterMonth, StringFormat='MMMM yyyy'}" Margin="40,10,0,0" Grid.Row="3" Grid.Column="1" />
                            <Button Grid.Row="3" Grid.Column="2" Margin="10,10,0,0" x:Name="btnClearMonth" Content="X" Click="ClearThisFilter_Click"  Padding="10,0"/>

                            <!-- Date -->
                            <Label Margin="0,10,0,0" Grid.Row="4" Grid.Column="0" Content="Filter by date"/>
                            <DatePicker SelectedDate="{Binding FilterDate}" Margin="40,10,0,0" Grid.Row="4" Grid.Column="1"/>
                            <Button Grid.Row="4" Grid.Column="2" Margin="10,10,0,0" x:Name="btnClearDate" Content="X" Click="ClearThisFilter_Click" Padding="10,0" />
                            
                            <!-- Reset filters button -->
                            <Button Margin="0,10,0,0" Grid.Row="5" Grid.ColumnSpan="3" Content="Reset filters" Click="btnFilterReset_Click"/>
                        </Grid>
                    </GroupBox>
                    <!-- Datagrid filtered transactions-->
                    <DataGrid Margin="0,20,0,0" ItemsSource="{Binding FilteredTransactions}" Grid.Row="1" x:Name="dgTransactions" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:N2} kr'}" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" />
                            <DataGridTextColumn Header="Category type" Binding="{Binding Category.Name}" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <Button Content="Edit" x:Name="btnEditTransaction" Padding="25, 0" Click="btnEditTransaction_Click" />
                        <Button Content="Delete" x:Name="btnDeleteTransaction" Padding="25, 0" Margin="10,0" Click="btnDeleteTransaction_Click" />
                        <Button Content="Clear" x:Name="btnClearTransactionSelection"  Padding="25, 0" Click="btnClearTransactionSelection_Click" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Row 2, Col 0: Cash-flow per -->
            <GroupBox Grid.Row="2" Grid.Column="0" Header="Cash-flow calculations per month">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Data grid for the monthly cash-flow -->
                    <DataGrid ItemsSource="{Binding MonthlyCashflow}" Grid.Row="0" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                        <!-- For my own reference: Page 272 in WPF 4.5 Unleashed by Adam Nathan -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Month" Binding="{Binding Month, StringFormat='MMMM yyyy'}"/>
                            <DataGridTextColumn Header="Revenues" Binding="{Binding Revenues, StringFormat='{}{0:N2} kr'}" />
                            <DataGridTextColumn Header="Expenses" Binding="{Binding Expenses, StringFormat='{}{0:N2} kr'}"/>
                            <DataGridTextColumn Header="Top 3 expenses" Binding="{Binding TopExpenses}"/>
                            <DataGridTextColumn Header="Top 3 revenues" Binding="{Binding TopRevenues}"/>
                            <DataGridTextColumn Header="Net" Binding="{Binding Net, StringFormat='{}{0:N2} kr'}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Report generation button -->
                    <Button Grid.Row="1" x:Name="btnGenerateReport" Content="Generate and export report (txt)" Padding="0, 5" Margin="0, 5, 0, 0" Click="btnGenerateReport_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
