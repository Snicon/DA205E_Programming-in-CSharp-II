<Window x:Class="DA205E_Assignment6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DA205E_Assignment6"
        xmlns:converters="clr-namespace:DA205E_Assignment6.UI.Converters"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Literature App"
        Height="650" 
        Width="1000">
    <Window.Resources>
        <converters:LiteratureCollectionToStringConverter x:Key="LiteratureCollectionToStringConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- Row 0, Col 0: Manage courses -->
        <GroupBox Grid.Column="0" Grid.Row="0" Margin="5,0,0,5" Header="Courses">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- For my own reference: Page 272 WPF 4.5 Unleashed by Adam Nathan -->
                <DataGrid x:Name="dgCourses" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}"/>
                        <DataGridTextColumn Header="Related literature" Binding="{Binding Literature, Converter={StaticResource LiteratureCollectionToStringConverter}}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnCourseAdd" Content="Add course" Padding="15,0" Margin="0,0,0,0" Click="btnCourseAdd_Click"/>
                    <Button x:Name="btnCourseEdit" Content="Edit" Padding="15,0" Margin="5,0,0,0" Click="btnCourseEdit_Click"/>
                    <Button x:Name="btnCourseDelete" Content="Delete" Padding="15,0" Margin="5,0,0,0" Click="btnCourseDelete_Click"/>
                    <Button x:Name="btnCourseClear" Content="Clear selection" Padding="15,0" Margin="5,0,0,0" Click="btnCourseClear_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.Column="0" Header="Manage literature" Margin="5,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgLiterature" ItemsSource="{Binding Literature}" SelectedItem="{Binding SelectedLiterature}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="dgLiterature_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}"/>
                        <DataGridTextColumn Header="Author" Binding="{Binding Author}"/>
                        <DataGridTextColumn Header="Year published" Binding="{Binding YearPublished}"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GroupBox Grid.Row="1" Grid.Column="0" Header="Reference style (Citation)">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 2">
                        <RadioButton x:Name="Harvard"  IsChecked="True" Content="Harvard" GroupName="citation" Checked="RadioButton_Checked"/> <!-- Pre-selecting -->
                        <RadioButton x:Name="Oxford"  Content="Oxford" GroupName="citation" Margin="25,0,25,0" Checked="RadioButton_Checked"/>
                        <RadioButton x:Name="APA7"  Content="APA7" GroupName="citation" Checked="RadioButton_Checked"/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="btnLiteratureAdd" Content="Add literature" Padding="15,0" Margin="0,0,0,0" Click="btnLiteratureAdd_Click"/>
                    <Button x:Name="btnLiteratureEdit" Content="Edit" Padding="15,0" Margin="5,0,0,0" Click="btnLiteratureEdit_Click"/>
                    <Button x:Name="btnLiteratureDelete" Content="Delete" Padding="15,0" Margin="5,0,0,0" Click="btnLiteratureDelete_Click"/>
                    <Button x:Name="btnLiteratureCitation" Content="Copy citation" Padding="15,0" Margin="5,0,0,0" Click="btnLiteratureCitation_Click"/>
                    <Button x:Name="btnLiteratureClear" Content="Clear selection" Padding="15,0" Margin="5,0,0,0" Click="btnLiteratureClear_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Header="Full literature information" Margin="5,0,0,0">
            <TextBox x:Name="txtLiteratureInfo" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/>
        </GroupBox>
    </Grid>
</Window>
